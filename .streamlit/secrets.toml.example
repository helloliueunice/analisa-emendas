# Copie para .streamlit/secrets.toml (NUNCA versione o arquivo real)
# ou cadastre em Streamlit Community Cloud > App > Settings > Secrets.

# Opção A – Claude API
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."
LLM_MODEL = "claude-sonnet-5-5"

# Opção B – modelo aberto rodando na rede do órgão (Ollama, vLLM, LM Studio)
# LLM_PROVIDER = "openai_compat"
# LLM_BASE_URL = "http://servidor-ia.orgao.gov.br:11434/v1"
# LLM_API_KEY  = "nao-usado"
# LLM_MODEL    = "llama3.1:70b"
